# Backend Environment Variables

# PostgreSQL connection string
# Local: postgresql://localhost:5432/rafay_portfolio
# Render: use the Internal Database URL from your Render PostgreSQL dashboard
DATABASE_URL="postgresql://localhost:5432/rafay_portfolio"

# Server port
PORT=3001

# Allowed CORS origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://rafay-portfolio.vercel.app
CORS_ORIGIN="http://localhost:5173"

# --- Strava daily run sync ---
# From your Strava API app: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Obtained once via `npm run strava:auth` (long-lived; the sync mints access tokens from it).
STRAVA_REFRESH_TOKEN=""
# How many trailing days each sync re-aggregates (self-heals missed days / late edits).
STRAVA_SYNC_WINDOW_DAYS="14"

# Shared secret the scheduled job sends in the `x-sync-secret` header to POST /api/runs/sync.
# Generate any long random string, e.g. `openssl rand -hex 32`. Must match the GitHub Actions secret.
SYNC_SECRET=""
