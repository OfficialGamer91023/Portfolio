// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tags        String[] // PostgreSQL array of technology tags
  githubUrl   String?
  liveUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  // --- "Verified notebook" case layout: problem -> method -> verified ---
  problem  String? // the failure or risk the work addressed
  method   String? // how it was solved
  verified String? // the proof it holds (test suite, invariant, audit trail)
  subtitle String? // meta line under the title (stack / context / accolade)
  figNo    String? // e.g. "fig.02" — the notebook figure number
}

/// One row of the open-source ledger under the work section.
model OpenSourceContribution {
  id         Int     @id @default(autoincrement())
  project    String // e.g. "HAMi (CNCF)", "lib2geom"
  detail     String // what the contribution was
  status     String // e.g. "merged", "3M+ users", "open ↗"
  statusKind String  @default("verify") // "verify" (green) | "plot" (orange, in-progress)
  url        String?
  order      Int     @default(0)
}

/// A single logged run, aggregated per day.
model Run {
  id      Int     @id @default(autoincrement())
  date    String  @unique // ISO yyyy-mm-dd
  km      Float
  pace    Float // minutes per km
  dur     Float // moving minutes
  speed   Float // km/h
  hr      Int? // avg bpm, null when the source did not record it
  elev    Int? // metres of gain, null/0 when unrecorded
  cal     Int?
  note    String?
  // Provenance. "seed" = the hardcoded initial export (Samsung Health), which the
  // daily Strava sync must NEVER overwrite. "strava" = a row owned by the sync, safe
  // to re-aggregate on every run. Default is the protected value on purpose: any row
  // whose origin we can't vouch for is left untouched by the sync.
  source  String  @default("seed")
}

model Experience {
  id        Int      @id @default(autoincrement())
  company   String
  role      String
  location  String
  startDate String
  endDate   String?  // null means "present"
  bullets   String[] // PostgreSQL array of bullet points
  order     Int      @default(0)
}

model Skill {
  id       Int    @id @default(autoincrement())
  name     String
  category String // e.g. "Languages", "Frontend", "Cloud & DevOps"
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
